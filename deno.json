{
  "name": "@tksh/stln-codec",
  "version": "0.1.0",
  "exports": "./src/mod.ts",
  "tasks": {
    "test": "deno test --allow-read tests/",
    "check": "deno check src/mod.ts scripts/freeze_goldens.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    // Golden fixtures must stay byte-exact; the markup formatter would
    // rewrap .svg outputs and reindent .json inputs.
    "exclude": [
      "tests/fixtures/golden/",
      "tests/fixtures/basic-data.sample-uint5.json",
      "tests/fixtures/lines-data.sample-uint5.json",
      "tests/fixtures/agg-data.sample-uint5.json",
      "tests/fixtures/showcase-202401_001.search.txt",
      "tests/fixtures/showcase-202412_001.search.txt"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.1",
    "@std/collections/chunk": "jsr:@std/collections@^1.3.0/chunk",
    "@std/collections/running-reduce": "jsr:@std/collections@^1.3.0/running-reduce",
    "@tksh/url-compressor": "jsr:@tksh/url-compressor@^1.1.1"
  }
}
