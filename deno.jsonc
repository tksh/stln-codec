{
  "name": "@tksh/stln-codec",
  "version": "0.1.1",
  "exports": "./src/mod.ts",
  "tasks": {
    "test": "deno test --allow-read tests/",
    "check": "deno check src/mod.ts scripts/freeze_goldens.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    // Golden fixtures must stay byte-exact; the markup formatter would
    // rewrap .svg outputs and reindent .json inputs.
    "exclude": [
      "tests/fixtures/golden/",
      "tests/fixtures/basic-data.sample-uint5.json",
      "tests/fixtures/lines-data.sample-uint5.json",
      "tests/fixtures/agg-data.sample-uint5.json",
      "tests/fixtures/showcase-202401_001.search.txt",
      "tests/fixtures/showcase-202412_001.search.txt"
    ]
  },
  "imports": {
    // Test-only assertions.
    "@std/assert": "jsr:@std/assert@^1.0.1",
    // Self-reference so tests exercise the public entry point.
    "stln-codec": "./src/mod.ts",

    // Shared std collections helpers (chunked splits, running reductions).
    "@std/collections/chunk": "jsr:@std/collections@^1.3.0/chunk",
    "@std/collections/running-reduce": "jsr:@std/collections@^1.3.0/running-reduce",

    // URL-safe string compression for the `0`-flag branch.
    "@tksh/url-compressor": "jsr:@tksh/url-compressor@^1.1.1",

    // Top-level modules: shared types, flags, streams, and the decode facade.
    "types": "./src/types.ts",
    "stln-constants": "./src/constants.ts",
    "compression": "./src/compression.ts",
    "flags": "./src/flags.ts",
    "decode": "./src/decode.ts",

    // Base-N encodings shared by the d-value codecs.
    "base-n/chars": "./src/base-n/chars.ts",
    "base-n/base52": "./src/base-n/base52.ts",
    "base-n/base53": "./src/base-n/base53.ts",
    "base-n/base64url": "./src/base-n/base64url.ts",
    "base-n/mod": "./src/base-n/mod.ts",

    // Color helpers for group-color codes.
    "color/hex": "./src/color/hex.ts",
    "color/rgb": "./src/color/rgb.ts",
    "color/opacity": "./src/color/opacity.ts",
    "color/mod": "./src/color/mod.ts",

    // Basic (non-lines) artwork params.
    "basic-data/basic-data": "./src/basic-data/basic_data.ts",
    "basic-data/mod": "./src/basic-data/mod.ts",

    // Per-line-group stroke colors.
    "group-colors/group-colors": "./src/group-colors/group_colors.ts",
    "group-colors/mod": "./src/group-colors/mod.ts",

    // Stroke-width runs with derived line indices.
    "widths-counts/widths-counts": "./src/widths-counts/widths_counts.ts",
    "widths-counts/mod": "./src/widths-counts/mod.ts",

    // bruteforce53: dictionary + mixed diff payloads.
    "bruteforce53/alphabets": "./src/bruteforce53/alphabets.ts",
    "bruteforce53/shift": "./src/bruteforce53/shift.ts",
    "bruteforce53/base-x": "./src/bruteforce53/base_x.ts",
    "bruteforce53/freq-diff": "./src/bruteforce53/freq_diff.ts",
    "bruteforce53/codebook": "./src/bruteforce53/codebook.ts",
    "bruteforce53/diff": "./src/bruteforce53/diff.ts",
    "bruteforce53/bruteforce53": "./src/bruteforce53/bruteforce53.ts",
    "bruteforce53/mod": "./src/bruteforce53/mod.ts",

    // bigint64: zero-padded absolute coordinates as one base-64url bigint.
    "bigint64/bigint64": "./src/bigint64/bigint64.ts",
    "bigint64/mod": "./src/bigint64/mod.ts",

    // swap63: one character per relative value in [-31, 31].
    "swap63/swap63": "./src/swap63/swap63.ts",
    "swap63/mod": "./src/swap63/mod.ts",

    // four16: custom base-16 over four 16-char sets.
    "four16/four16": "./src/four16/four16.ts",
    "four16/mod": "./src/four16/mod.ts",

    // Canvas size and relative/absolute conversion.
    "size-data/size-data": "./src/size-data/size_data.ts",
    "size-data/mod": "./src/size-data/mod.ts",

    // SVG document generation for both path modes.
    "svg/svg": "./src/svg/svg.ts",
    "svg/mod": "./src/svg/mod.ts",

    // Lines-data encode pipeline: parsing, compression, methods, best mix.
    "encode/parse": "./src/encode/parse.ts",
    "encode/compress": "./src/encode/compress.ts",
    "encode/methods": "./src/encode/methods.ts",
    "encode/best-mix": "./src/encode/best_mix.ts",
    "encode/mod": "./src/encode/mod.ts"
  }
}
